DATABASE_URL="postgresql://usuario:senha@localhost:5432/matchanimal?schema=public"
JWT_ACCESS_SECRET="substitua-por-um-segredo-longo-e-aleatorio"
WEB_ORIGIN="http://localhost:3000,https://localhost,capacitor://localhost"
PORT=4000
# URL pública usada para montar os links das imagens enviadas.
API_PUBLIC_URL="http://localhost:4000"
# Opcional: diretório de mídia local para desenvolvimento. Use storage de objetos em produção.
# MEDIA_STORAGE_DIR="./storage"
SUPER_MATCH_DAILY_LIMIT=3
# Configure uma URL de webhook que aceite { to, resetUrl, expiresInMinutes } para enviar links de recuperação.
# Sem webhook, o link só aparece no log de desenvolvimento. Configure antes de expor a API publicamente.
# PASSWORD_RESET_WEBHOOK_URL="https://seu-provedor.example/send-password-reset"
# PASSWORD_RESET_WEBHOOK_SECRET=""
# IDs de usuários operadores separados por vírgula, usados para liberar /api/safety/admin/*.
# ADMIN_USER_IDS="id-do-usuario-admin"
# E-mails administrativos normalizados (útil no bootstrap da primeira conta de admin).
# ADMIN_EMAILS="admin@matchanimal.com"
# Geocodificador compatível com Nominatim; substitua por serviço próprio/comercial ao escalar.
GEOCODER_BASE_URL="https://nominatim.openstreetmap.org"
# GEOCODER_CONTACT_EMAIL="equipe@seudominio.com.br"
# Opcional: REDIS_URL="redis://localhost:6379"
